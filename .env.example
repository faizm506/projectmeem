# Copy to .env (or export these in your shell). Never commit real secrets.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=*
# Production only: a private admin path (never leave it as admin/) and set to 1 only when behind your own proxy
ADMIN_URL=admin/
TRUST_PROXY_HEADERS=0
CSRF_TRUSTED_ORIGINS=
# Payments: "mock" (testing only, DEBUG only) or "razorpay"
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Email: console prints emails in the terminal. Use smtp for real sending.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MEEM <hello@meem.example>
ADMIN_NOTIFY_EMAIL=admin@meem.example
